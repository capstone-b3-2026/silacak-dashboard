DATABASE_URL=postgresql://silacak:silacak@db:5432/silacak

# Nilai di bawah = bawaan aplikasi. Di mode portable diubah lewat halaman /pengaturan, bukan file ini.
STAGNANT_RADIUS_M=50
STAGNANT_PERIMETER_M=50
STAGNANT_WINDOW_INSIDE_MINUTES=480
STAGNANT_WINDOW_OUTSIDE_MINUTES=240
STAGNANT_CHECK_INTERVAL_MINUTES=2
OFFTRAIL_DEBOUNCE_PACKETS=3
DATA_RETENTION_DAYS=0

CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# --- Opsional (bawaan aman untuk Docker/dev; mode portable mengaturnya otomatis lewat launcher) ---
# Ingest serial base station tertanam. off = pakai bridge eksternal (reference-for-hardware-team/).
# SERIAL_PORT=auto          # auto | COM5 | /dev/ttyUSB0 | off
# SERIAL_BAUD=115200
# FIRMWARE_SUPPORTS_CFG=false   # true hanya kalau firmware base sudah menerima CFG dari dashboard
# RAW_LOG=true              # simpan tiap baris CSV_DATA mentah ke DATA_DIR/raw/ (backup lapangan)
# FRONTEND_DIR=../frontend/dist   # backend menyajikan dashboard sendiri (tanpa nginx/Node)
